# Copy this file to .env and fill in your real values.
# The .env file is git-ignored so your secrets never get committed.

# --- Core ---------------------------------------------------------------
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Must be set in production. The key previously hardcoded in settings.py is
# in git history and must NOT be reused.
SECRET_KEY=

# True for local development only. Leave unset (or False) in production —
# DEBUG=True on a public site exposes tracebacks and settings.
DEBUG=True

# --- Database -----------------------------------------------------------
# Leave unset locally to use SQLite. In production set the Postgres URL,
# e.g. postgresql://user:password@host/dbname
# Note: SQLite ignores SELECT FOR UPDATE, so the seat-locking guarantees
# only hold on Postgres.
DATABASE_URL=

# --- Email (Gmail SMTP) -------------------------------------------------
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password

# --- Razorpay (Test Mode) -----------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Required for the webhook endpoint to accept anything. It fails closed:
# with this unset, /movies/webhook/razorpay/ returns 503 by design.
# Get it from Razorpay Dashboard > Settings > Webhooks.
RAZORPAY_WEBHOOK_SECRET=
